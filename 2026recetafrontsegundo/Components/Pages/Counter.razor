@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">incrementar</button>
<button class="btn btn-primary" @onclick="DecrementCount">decrementar</button>
<button class="btn btn-primary" @onclick="ResetCount">reiniciar</button>

@code {
    private int currentCount = 2;

    private void IncrementCount()
    {
        currentCount=currentCount*currentCount;
    }
    private void DecrementCount()
    {
        if (!(currentCount <= 0)) {
            currentCount--;
        }
    }
    private void ResetCount()
    {
        currentCount = 0;
    }
}
